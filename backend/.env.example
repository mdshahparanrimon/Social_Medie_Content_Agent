# Copy this file to .env. Only the database connection lives here;
# AI keys, platform tokens and posting times are set in the dashboard (Settings) and stored encrypted.

# --- Database ---
# DB_DRIVER=mongodb
# MongoDB Atlas: Database -> Connect -> Drivers -> copy the connection string and put your DB user's password in it.
# Local MongoDB later: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=content_agent

# Encrypts the keys saved in Settings. Generated automatically on first start if missing. Keep it safe:
# if it's lost or changed, re-enter your keys in Settings.
# ENCRYPTION_KEY=

# --- Accounts ---
# The first account to sign up is the admin (app owner). Extra owners, comma-separated:
# ADMIN_EMAILS=you@example.com
# Emails can also be configured in Settings → Sign-in & email:
# RESEND_API_KEY=
# EMAIL_FROM=Content Agent <hello@yourdomain.com>

# --- Server ---
# PORT=4000
# HOST=127.0.0.1
# The app's public address: login redirects, email links and the cookie security all use it.
# FRONTEND_ORIGIN=http://localhost:3000
# Address the platforms send you back to after "Connect" (used in the Callback URLs).
# PUBLIC_API_URL=http://localhost:4000
